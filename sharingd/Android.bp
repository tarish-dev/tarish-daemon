// barqsharingd — the unprivileged half.
//
// Runs as its own AID -- system_ext_barq (7500) -- with no capabilities, in its own
// SELinux domain. Everything
// that parses remote input lives here so that code is never in the same process
// as CAP_NET_ADMIN. See ../docs/ARCHITECTURE.md.
rust_binary {
    name: "barqsharingd",
    crate_name: "barqsharingd",
    srcs: ["src/main.rs"],
    edition: "2021",
    rustlibs: [
        "libandroid_logger",
        "libbinder_rs",
        "liblibc",
        "liblog_rust",
        "libopenssl",
        "libcpio_archive_barq",
        "libflate2",
        "dev.barq-rust",
        // A dylib, so it MUST be deployed alongside this binary -- scripts/gos-push.sh
        // in the integrator repo carries it. See BUILD-NOTES 45 for what a device
        // answering against a stale interface library costs.
        "libbarq_protocol",
    ],
    init_rc: ["barqsharingd.rc"],
    system_ext_specific: true,
}
