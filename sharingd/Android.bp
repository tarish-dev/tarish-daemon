// tarishsharingd — the unprivileged half.
//
// Runs as its own AID -- system_ext_tarish (7500) -- with no capabilities, in its own
// SELinux domain. Everything
// that parses remote input lives here so that code is never in the same process
// as CAP_NET_ADMIN. See ../docs/ARCHITECTURE.md.
rust_binary {
    name: "tarishsharingd",
    crate_name: "tarishsharingd",
    srcs: ["src/main.rs"],
    edition: "2021",
    rustlibs: [
        "libandroid_logger",
        "libbinder_rs",
        "liblibc",
        "liblog_rust",
        "libopenssl",
        "libcpio_archive_tarish",
        "libflate2",
        "dev.tarish-rust",
        // A dylib, so it MUST be deployed alongside this binary -- any deploy script
        // that ships this daemon must carry it too: a device left answering against a
        // stale interface library reports UNKNOWN_TRANSACTION for every method added
        // since, while every older one keeps working. Silent, and convincing.
        "libtarish_protocol",
    ],
    init_rc: ["tarishsharingd.rc"],
    system_ext_specific: true,
}
