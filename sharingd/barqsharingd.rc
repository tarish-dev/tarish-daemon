# barqsharingd — the unprivileged half of Barq.
#
# No capabilities at all. `inet` is a supplementary GROUP, not a capability:
# Android gates socket creation on group membership, so this is the minimum
# needed to talk to a peer and nothing more.
#
# Started after barqd, though it does not require it: with no link up it simply
# reports linkUp=false rather than failing.

# Received archives land here. Created by init rather than by the daemon so the
# ownership and mode are set by something that has the standing to set them, and so
# the directory exists before the first transfer rather than on the first write.
#
# 0700 nobody: only this daemon can read what a peer sent until the app collects it.
on post-fs-data
    mkdir /data/misc/barq 0700 nobody nobody
    mkdir /data/misc/barq/inbox 0700 nobody nobody

service barqsharingd /system_ext/bin/barqsharingd
    class late_start
    user nobody
    group nobody inet
    disabled
    oneshot false
    restart_period 10

on property:sys.boot_completed=1
    start barqsharingd
