# tarishctl — shell access to the daemon, for testing. USERDEBUG AND ENG ONLY.
#
# tarish_service is findable by platform_app and nothing else, which is correct: the
# control plane can start a transfer and accept an incoming one, so it is not something
# an arbitrary uid should reach. That also means `adb shell` gets
#
#     Service dev.tarish.ITarishService/default does not exist
#
# even though `service list` shows it -- service_manager reports "not found" rather than
# "not permitted", so the refusal does not look like a permission problem at all.
#
# These grants are wrapped in userdebug_or_eng() so they cannot reach a user build. That
# wrapper is the whole safety story here; without it this file would hand every shell on
# a production device the ability to send files off it.
userdebug_or_eng(`
    allow shell tarish_service:service_manager find;
    binder_call(shell, tarishsharingd)
    binder_call(tarishsharingd, shell)

    # Sending needs the daemon to read the file descriptors the shell passes it. Without
    # this the transfer starts and reads zero bytes, which presents as the peer rejecting
    # an empty file rather than as a policy denial.
    allow tarishsharingd shell:fd use;
    allow tarishsharingd shell_data_file:file { read getattr };
    allow tarishsharingd shell_data_file:dir search;

    # THE APP'S SHELL CONTROL CHANNEL.
    #
    # Bluetooth and Wi-Fi Direct sends are framework API the daemon cannot reach, so an
    # end-to-end harness cannot drive them through tarishctl at all -- both transports were
    # reported SKIP in every run and had never been exercised on real hardware. DebugBridge
    # is an abstract-namespace socket in the app that accepts one line and performs the
    # same call the share sheet would.
    #
    # This is the THIRD gate on it. Android.bp excludes the class from a non-debuggable
    # build and it re-checks Build.IS_DEBUGGABLE at runtime; without this rule the socket
    # is unreachable even when the class is present.
    allow shell platform_app:unix_stream_socket connectto;
')
