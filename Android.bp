// Tarish — AWDL transport daemon (privileged half).
//
// Rust rather than C: the sharing daemon it feeds parses untrusted remote input,
// and this process holds CAP_NET_ADMIN and CAP_NET_RAW. See docs/ARCHITECTURE.md.
//
// Dependencies are deliberately few. This is the privileged half, so its
// dependency surface is part of its threat model -- the netlink route is written
// against libc rather than pulling in an async runtime for one message.
rust_binary {
    name: "tarishd",
    crate_name: "tarishd",
    srcs: ["src/main.rs"],
    edition: "2021",
    rustlibs: [
        "libandroid_logger",
        "liblibc",
        "liblog_rust",

    ],
    init_rc: ["init/tarish.rc"],
    system_ext_specific: true,
}
